# Example only. Docker Compose reads .env. Native PHP reads environment variables, not this file.
APP_ENV=local
APP_BASE_PATH=
DB_HOST=database
DB_PORT=3306
DB_DATABASE=expernet
DB_USERNAME=expernet
DB_PASSWORD=change_me_local_only
DB_ROOT_PASSWORD=change_me_root_local_only

# Private pedagogical portal (website accounts, not Microsoft 365 accounts)
PORTAL_EMAIL_DOMAIN=expernet.re
PORTAL_DEMO=true
PORTAL_MFA=true
# Generate a unique value: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
APP_KEY=

# Collaboration: empty WS URL enables HTTP refresh every 5 seconds.
CHAT_WS_URL=
CHAT_WS_BIND=127.0.0.1
CHAT_WS_PORT=8094
CHAT_ALLOWED_ORIGINS=http://127.0.0.1:8093
# Dedicated JWT-authenticated Jitsi service, no public fallback.
CHAT_MEETING_URL=
CHAT_MEETING_APP_ID=
CHAT_MEETING_SECRET=

# ClamAV executable path; production refuses uploads without a working scanner.
CHAT_AV_BINARY=
CHAT_REQUIRE_SCAN=false
